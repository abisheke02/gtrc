NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://gtrc:gtrc@localhost:5432/gtrc
# Long random string: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Razorpay: https://dashboard.razorpay.com/app/keys (use rzp_test_ keys until go-live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Club inbox: gets a copy of every paid booking and enquiry
CONTACT_EMAIL=goldentriggerriffleclub@gmail.com
# e.g. smtps://goldentriggerriffleclub%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# (Gmail needs an App Password). Leave empty in dev: emails are logged to the console.
SMTP_URL=
MAIL_FROM="Golden Trigger Rifle Club <goldentriggerriffleclub@gmail.com>"

# First admin login, created by `npm run db:seed`
ADMIN_SEED_EMAIL=goldentriggerriffleclub@gmail.com
ADMIN_SEED_PASSWORD=
